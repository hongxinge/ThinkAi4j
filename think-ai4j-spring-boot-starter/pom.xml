<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hongxinge</groupId>
        <artifactId>think-ai4j</artifactId>
        <version>1.0.2</version>
    </parent>

    <artifactId>think-ai4j-spring-boot-starter</artifactId>
    <packaging>jar</packaging>

    <name>ThinkAi4j Spring Boot Starter</name>
    <description>Auto-configuration for ThinkAi4j</description>

    <dependencies>
        <dependency>
            <groupId>com.hongxinge</groupId>
            <artifactId>think-ai4j-core</artifactId>
        </dependency>
        <!-- 内部能力模块必须传递给下游：自动配置类与 ThinkAiProperties 直接引用其类型，
             标记为 optional 会导致仅引入 starter 的项目在启动时抛 NoClassDefFoundError。 -->
        <dependency>
            <groupId>com.hongxinge</groupId>
            <artifactId>think-ai4j-provider-openai-compat</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hongxinge</groupId>
            <artifactId>think-ai4j-memory</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hongxinge</groupId>
            <artifactId>think-ai4j-tool</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hongxinge</groupId>
            <artifactId>think-ai4j-rag</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hongxinge</groupId>
            <artifactId>think-ai4j-agent</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hongxinge</groupId>
            <artifactId>think-ai4j-memory-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hongxinge</groupId>
            <artifactId>think-ai4j-observability</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.hongxinge</groupId>
            <artifactId>think-ai4j-store-pgvector</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 自动装配冒烟测试：确保「仅引入 starter」时容器可启动且 Provider 已注册 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
